# Copy this to .env on the VPS (which is gitignored) and fill in real values.
# Read by docker-compose.yml's env_file directive and passed to the backend container.

# --- Telegram alerts ---
# Bot token from @BotFather (looks like "8001234567:AAFy...long-string")
TG_BOT_TOKEN=

# Your personal Telegram chat id (numeric, get from @userinfobot)
TG_CHAT_ID=

# --- UptimeRobot API polling (primary uptime alerts) ---
# Main API key from https://uptimerobot.com/integrations -> Main API keys -> Create.
# Backend polls /v2/getMonitors every 2 min and alerts on up<->down transitions.
UPTIMEROBOT_API_KEY=

# --- Better Stack outgoing webhook (optional, currently unused) ---
# Kept as ready-to-go fallback if we ever migrate to a service with free webhooks.
# Random URL-safe string. Generate fresh with: openssl rand -hex 16
# Leave empty if not using.
BETTERSTACK_WEBHOOK_SECRET=