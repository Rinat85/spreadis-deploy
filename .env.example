# Copy this to .env on the VPS (which is gitignored) and fill in real values.
# Read by docker-compose.yml's env_file directive and passed to the backend container.

# --- Telegram alert relay (Better Stack incidents -> Telegram) ---
# Bot token from @BotFather (looks like "8001234567:AAFy...long-string")
TG_BOT_TOKEN=

# Your personal Telegram chat id (numeric, get from @userinfobot)
TG_CHAT_ID=

# --- Better Stack outgoing webhook auth ---
# Random URL-safe string. Better Stack hits POST /api/webhooks/betterstack/<this>.
# Generate fresh with:  openssl rand -hex 16
BETTERSTACK_WEBHOOK_SECRET=